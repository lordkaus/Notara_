<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:background="?android:attr/colorBackground"
    tools:ignore="Overdraw">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@android:color/transparent"
        app:elevation="0dp">
        <View
            android:id="@+id/topColorIndicator"
            android:layout_width="match_parent"
            android:layout_height="4dp"
            android:background="?attr/colorPrimary"
            android:visibility="gone" />
    </com.google.android.material.appbar.AppBarLayout>

    <LinearLayout
        android:id="@+id/contentContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingTop="4dp"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <EditText
            android:id="@+id/etChecklistTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@null"
            android:hint="@string/checklist_title_hint"
            android:inputType="textCapSentences"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:textColor="?android:attr/textColorPrimary"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvChecklistDate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:text="@string/date_label"
            android:alpha="0.6"
            android:textSize="11sp" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilNewItem"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            app:hintEnabled="false"
            app:endIconMode="custom"
            app:endIconDrawable="@drawable/ic_add"
            app:endIconContentDescription="@string/add_item_hint"
            app:boxStrokeWidth="0dp"
            app:boxStrokeWidthFocused="0dp"
            android:background="?attr/colorSurfaceVariant"
            app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.SmallComponent">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etNewItem"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/add_item_hint"
                android:inputType="textCapSentences"
                android:padding="12dp"
                android:background="@null" />
        </com.google.android.material.textfield.TextInputLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="8dp">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvChecklist"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:paddingBottom="16dp"
                android:clipToPadding="false" />
        </FrameLayout>

        <TextView
            android:id="@+id/tvEmptyHint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginTop="32dp"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:text="Clique duplo para adicionar lista"
            android:alpha="0.7"
            android:textSize="14sp"
            android:visibility="gone" />
    </LinearLayout>

    <View
        android:id="@+id/vFoldClick"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:clickable="true"
        android:focusable="true"
        android:background="@android:color/transparent"
        app:layout_anchor="@id/contentContainer"
        app:layout_anchorGravity="top|end" />

    <LinearLayout
        android:id="@+id/layoutNoteSchedule"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:visibility="gone"
        app:layout_anchor="@id/contentContainer"
        app:layout_anchorGravity="top|end"
        android:layout_marginTop="45dp"
        android:layout_marginEnd="38dp">

        <ImageButton
            android:id="@+id/btnChecklistReminder"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_notifications"
            android:contentDescription="@null"
            app:tint="?attr/colorOnSurfaceVariant" />

        <ImageButton
            android:id="@+id/btnChecklistAlarm"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_alarm"
            android:contentDescription="@null"
            app:tint="?attr/colorOnSurfaceVariant" />
    </LinearLayout>

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/btnConvertFAB"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:contentDescription="@null"
        app:layout_anchor="@id/btnSaveChecklist"
        app:layout_anchorGravity="start|center_vertical"
        android:layout_marginEnd="80dp"
        app:srcCompat="@drawable/ic_convert"
        app:elevation="6dp"
        app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.MediumComponent" />

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/btnSaveChecklist"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="16dp"
        android:contentDescription="@null"
        app:srcCompat="@drawable/ic_save"
        app:elevation="6dp"
        app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.MediumComponent" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>
